<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Redis-backed rate limiter state for Wapper, so throttling budgets are shared across application instances.</Description>
    <!-- StackExchange.Redis 2.x carries no trimming or AOT annotations, so this package
         cannot honestly claim either. The other three still do; a consumer that needs
         Native AOT keeps the in-process limiter. -->
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Wapper/Wapper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wapper.RateLimiting.Redis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
