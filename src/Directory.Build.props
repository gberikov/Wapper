<Project>

  <!-- MSBuild stops at the first Directory.Build.props it finds walking up, so the
       repository root one has to be imported by hand. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package metadata shared by every shipping project. -->
  <PropertyGroup>
    <Authors>Gany Berikov</Authors>
    <Product>Wapper</Product>
    <Copyright>Copyright (c) Gany Berikov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gberikov/Wapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gberikov/Wapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>whatsapp;whatsapp-cloud-api;meta;messaging;chatbot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Version comes from the git tag. No tag yet means 0.0.0-alpha.0.N, which is
       exactly what an unreleased build should look like. -->
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
